{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5000",
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "user-requests",
    "GroupId": "rate-limiter-reader",
    "RetryDelay": "00:00:02"
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27018/?directConnection=true",
    "DatabaseName": "rate_limiter",
    "CollectionName": "rate_limits",
    "SynchronizationPollInterval": "00:00:01"
  },
  "RateLimiter": {
    "Window": "00:01:00"
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "Redis": {
    "ConnectionString": "localhost:6379,abortConnect=false",
    "KeyPrefix": "rate-limiter",
    "BlockDuration": "00:05:00"
  }
}
